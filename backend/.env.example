PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/Grievance_db
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password1!
# Required for citizen registration and email verification.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_SERVICE=gmail
# For Gmail, use a Google App Password (with 2-Step Verification enabled), not your normal account password.
SMTP_USER=your-account@gmail.com
SMTP_PASS=your-gmail-app-password
MAIL_FROM="Grievance System <your-account@gmail.com>"
TEST_EMAIL=recipient@example.com
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=replace-with-cloudinary-api-secret
CLIENT_URL=http://localhost:5173
# Behind a reverse proxy / load balancer, set the NUMBER of proxies in front of Node (usually 1), so the
# login lock-out and the audit trail see the real visitor IP. Leave empty when Node is reached directly.
# "true" is refused on purpose. See backend/CHANGES.md.
TRUST_PROXY=
