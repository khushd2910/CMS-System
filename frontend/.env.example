# Copy this file to ".env" only if you need to change the defaults.

# Where the Vite dev server forwards "/api" requests (your Express backend).
VITE_PROXY_TARGET=http://localhost:3000

# Production only: full backend URL (for example https://api.example.gov.in/api).
# Leave empty in development so requests go through the proxy above.
# VITE_API_BASE_URL=
